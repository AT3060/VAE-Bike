"""
Bike VAE Project - Jupyter Notebook for VAE Training

This notebook demonstrates how to train the Variational Autoencoder on the bike image dataset,
including hyperparameter optimization with Optuna.
"""

import os
import sys
import torch
import numpy as np
import matplotlib.pyplot as plt
from torch.utils.data import DataLoader
import optuna
from tqdm.notebook import tqdm

# Add project root to path
sys.path.append('..')

# Import project modules
from src.data_loading import BikeDataset, get_data_loaders
from src.vae_model import VAE
from src.training import train_vae
from src.hyperparameter_optimization import VAEHyperparameterOptimizer, create_model_from_best_hyperparameters

# Set random seed for reproducibility
torch.manual_seed(42)
np.random.seed(42)

# Configuration
DATA_DIR = "../data"  # Update this to your dataset path
IMG_SIZE = (128, 128)
BATCH_SIZE = 32
LATENT_DIM = 128
HIDDEN_DIMS = [32, 64, 128, 256, 512]
KL_WEIGHT = 0.005
LEARNING_RATE = 1e-4
NUM_EPOCHS = 50

# Check if CUDA is available
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# Create directories for logs and checkpoints
os.makedirs('../logs', exist_ok=True)
os.makedirs('../checkpoints', exist_ok=True)

# Create dataset and dataloader
print("Creating dataset and dataloader...")
train_loader, val_loader = get_data_loaders(
    DATA_DIR, 
    batch_size=BATCH_SIZE, 
    img_size=IMG_SIZE
)

print(f"Train batches: {len(train_loader)}")
print(f"Validation batches: {len(val_loader)}")

# SECTION 1: Training with Default Parameters
# ===========================================

print("\n=== Training with Default Parameters ===\n")

# Create VAE model with default parameters
model = VAE(
    img_channels=3,
    hidden_dims=HIDDEN_DIMS,
    latent_dim=LATENT_DIM,
    img_size=IMG_SIZE,
    kl_weight=KL_WEIGHT
)

# Define training configuration
train_config = {
    'optimizer': 'adam',
    'learning_rate': LEARNING_RATE,
    'weight_decay': 1e-5,
    'num_epochs': NUM_EPOCHS,
    'early_stopping_patience': 10,
    'use_cuda': torch.cuda.is_available(),
    'log_dir': '../logs/default',
    'checkpoint_dir': '../checkpoints/default'
}

# Train the model
print("Training VAE with default parameters...")
trainer = train_vae(model, train_loader, val_loader, train_config)

print(f"Best validation loss: {trainer.best_val_loss:.4f}")

# SECTION 2: Hyperparameter Optimization with Optuna
# =================================================

print("\n=== Hyperparameter Optimization with Optuna ===\n")

# Ask if user wants to run hyperparameter optimization (it can be time-consuming)
run_optuna = input("Do you want to run hyperparameter optimization with Optuna? (y/n): ")

if run_optuna.lower() == 'y':
    # Number of trials for Optuna
    N_TRIALS = 20  # Adjust based on available time and resources
    
    # Create hyperparameter optimizer
    optimizer = VAEHyperparameterOptimizer(
        train_loader=train_loader,
        val_loader=val_loader,
        img_size=IMG_SIZE,
        img_channels=3,
        study_name='vae_optimization',
        n_trials=N_TRIALS
    )
    
    # Run optimization
    print(f"Running Optuna optimization with {N_TRIALS} trials...")
    study = optimizer.optimize()
    
    # Print best hyperparameters
    print("\nBest hyperparameters:")
    print(study.best_params)
    
    # Create model with best hyperparameters
    best_model = create_model_from_best_hyperparameters(img_channels=3, img_size=IMG_SIZE)
    
    # Train with best hyperparameters
    best_config = {
        'optimizer': study.best_params['optimizer'],
        'learning_rate': study.best_params['learning_rate'],
        'weight_decay': study.best_params['weight_decay'],
        'num_epochs': study.best_params['num_epochs'],
        'early_stopping_patience': study.best_params['early_stopping_patience'],
        'use_cuda': torch.cuda.is_available(),
        'log_dir': '../logs/best',
        'checkpoint_dir': '../checkpoints/best'
    }
    
    print("\nTraining VAE with best hyperparameters...")
    best_trainer = train_vae(best_model, train_loader, val_loader, best_config)
    
    print(f"Best validation loss with optimized hyperparameters: {best_trainer.best_val_loss:.4f}")
else:
    print("Skipping hyperparameter optimization.")

# SECTION 3: Visualizing Training Results
# ======================================

print("\n=== Visualizing Training Results ===\n")

# Load training metrics
import json

try:
    with open('../logs/default/metrics_history.json', 'r') as f:
        metrics = json.load(f)
    
    # Plot training and validation loss
    plt.figure(figsize=(12, 5))
    
    plt.subplot(1, 2, 1)
    plt.plot(metrics['train_loss'], label='Train Loss')
    plt.plot(metrics['val_loss'], label='Validation Loss')
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.title('Training and Validation Loss')
    plt.legend()
    
    plt.subplot(1, 2, 2)
    plt.plot(metrics['train_recon_loss'], label='Train Reconstruction Loss')
    plt.plot(metrics['val_recon_loss'], label='Validation Reconstruction Loss')
    plt.xlabel('Epoch')
    plt.ylabel('Reconstruction Loss')
    plt.title('Reconstruction Loss')
    plt.legend()
    
    plt.tight_layout()
    plt.show()
    
    # Plot KL divergence
    plt.figure(figsize=(8, 5))
    plt.plot(metrics['train_kl_loss'], label='Train KL Loss')
    plt.plot(metrics['val_kl_loss'], label='Validation KL Loss')
    plt.xlabel('Epoch')
    plt.ylabel('KL Loss')
    plt.title('KL Divergence Loss')
    plt.legend()
    plt.show()
    
except FileNotFoundError:
    print("Metrics file not found. Make sure training has completed successfully.")

# SECTION 4: Loading and Testing the Trained Model
# ==============================================

print("\n=== Loading and Testing the Trained Model ===\n")

# Load the best model
try:
    checkpoint_path = '../checkpoints/default/best_model.pth'
    checkpoint = torch.load(checkpoint_path, map_location=device)
    
    # Create a new model instance
    test_model = VAE(
        img_channels=3,
        hidden_dims=HIDDEN_DIMS,
        latent_dim=LATENT_DIM,
        img_size=IMG_SIZE,
        kl_weight=KL_WEIGHT
    )
    
    # Load state dict
    test_model.load_state_dict(checkpoint['model_state_dict'])
    test_model.to(device)
    test_model.eval()
    
    print(f"Loaded model from {checkpoint_path}")
    print(f"Model was trained for {checkpoint['epoch']} epochs")
    print(f"Validation loss: {checkpoint['val_loss']:.4f}")
    
    # Test reconstruction on a batch of validation images
    with torch.no_grad():
        val_batch = next(iter(val_loader))
        val_batch = val_batch.to(device)
        recon_batch, _, _, _ = test_model(val_batch)
        
        # Denormalize images
        mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1).to(device)
        std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1).to(device)
        
        val_batch = val_batch * std + mean
        recon_batch = recon_batch * std + mean
        
        # Clamp values to [0, 1]
        val_batch = torch.clamp(val_batch, 0, 1)
        recon_batch = torch.clamp(recon_batch, 0, 1)
        
        # Display original and reconstructed images
        from torchvision.utils import make_grid
        
        # Select a subset of images
        n_images = 8
        comparison = torch.cat([val_batch[:n_images], recon_batch[:n_images]])
        
        # Create a grid
        grid = make_grid(comparison, nrow=n_images)
        
        # Display the grid
        plt.figure(figsize=(15, 6))
        plt.imshow(grid.permute(1, 2, 0).cpu())
        plt.axis('off')
        plt.title('Original Images (top) vs. Reconstructed Images (bottom)')
        plt.show()
        
except FileNotFoundError:
    print("Model checkpoint not found. Make sure training has completed successfully.")

print("\nTraining notebook complete!")
