"""
Bike VAE Project - Jupyter Notebook for Image Generation

This notebook demonstrates how to generate new bike images using the trained Variational Autoencoder,
including sampling from the latent space, creating variations, and exploring the latent space.
"""

import os
import sys
import torch
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from torchvision.utils import make_grid, save_image
from tqdm.notebook import tqdm

# Add project root to path
sys.path.append('..')

# Import project modules
from src.vae_model import VAE
from src.image_generation import ImageGenerator, load_and_preprocess_image
from src.training import load_model

# Set random seed for reproducibility
torch.manual_seed(42)
np.random.seed(42)

# Configuration
IMG_SIZE = (128, 128)
LATENT_DIM = 128
HIDDEN_DIMS = [32, 64, 128, 256, 512]
KL_WEIGHT = 0.005

# Check if CUDA is available
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# Create output directory for generated images
os.makedirs('../generated_images', exist_ok=True)

# SECTION 1: Loading the Trained Model
# ===================================

print("\n=== Loading the Trained Model ===\n")

# Load the best model
try:
    # Try to load the best model from hyperparameter optimization
    checkpoint_path = '../checkpoints/best/best_model.pth'
    if not os.path.exists(checkpoint_path):
        # Fall back to default model if best model doesn't exist
        checkpoint_path = '../checkpoints/default/best_model.pth'
    
    # Create a new model instance
    model = VAE(
        img_channels=3,
        hidden_dims=HIDDEN_DIMS,
        latent_dim=LATENT_DIM,
        img_size=IMG_SIZE,
        kl_weight=KL_WEIGHT
    )
    
    # Load model
    model = load_model(checkpoint_path, model, device)
    print(f"Loaded model from {checkpoint_path}")
    
    # Create image generator
    generator = ImageGenerator(model, device, IMG_SIZE)
    
except FileNotFoundError:
    print("Model checkpoint not found. Make sure training has completed successfully.")
    print("For demonstration purposes, we'll create a new untrained model.")
    
    # Create a new untrained model for demonstration
    model = VAE(
        img_channels=3,
        hidden_dims=HIDDEN_DIMS,
        latent_dim=LATENT_DIM,
        img_size=IMG_SIZE,
        kl_weight=KL_WEIGHT
    )
    model.to(device)
    
    # Create image generator
    generator = ImageGenerator(model, device, IMG_SIZE)

# SECTION 2: Generating Random Bike Images
# ======================================

print("\n=== Generating Random Bike Images ===\n")

# Generate random images
num_samples = 16
print(f"Generating {num_samples} random bike images...")

# Generate images
images = generator.generate_images(num_samples, seed=42)

# Display images
grid = make_grid(images, nrow=4)
plt.figure(figsize=(12, 12))
plt.imshow(grid.permute(1, 2, 0).cpu())
plt.axis('off')
plt.title('Generated Bike Images')
plt.show()

# Save images
output_path = '../generated_images/random_samples.png'
generator.save_images(images, output_path, nrow=4)
print(f"Saved random samples to {output_path}")

# SECTION 3: Latent Space Interpolation
# ===================================

print("\n=== Latent Space Interpolation ===\n")

# Generate two random latent vectors
z1 = generator.sample_latent_vectors(1, seed=42)
z2 = generator.sample_latent_vectors(1, seed=100)

# Generate images from these vectors
with torch.no_grad():
    img1 = model.decoder(z1)
    img2 = model.decoder(z2)

# Interpolate between the two latent vectors
steps = 10
alphas = torch.linspace(0, 1, steps).to(device)
interpolated_images = []

with torch.no_grad():
    for alpha in alphas:
        # Interpolate in the latent space
        z_interp = (1 - alpha) * z1 + alpha * z2
        
        # Generate image from interpolated latent vector
        img_interp = model.decoder(z_interp)
        
        # Denormalize
        mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1).to(device)
        std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1).to(device)
        
        img_interp = img_interp * std + mean
        img_interp = torch.clamp(img_interp, 0, 1)
        
        interpolated_images.append(img_interp)

# Concatenate all interpolated images
interpolated_images = torch.cat(interpolated_images, dim=0)

# Display interpolation
grid = make_grid(interpolated_images, nrow=steps)
plt.figure(figsize=(15, 4))
plt.imshow(grid.permute(1, 2, 0).cpu())
plt.axis('off')
plt.title('Latent Space Interpolation')
plt.show()

# Save interpolation
output_path = '../generated_images/interpolation.png'
generator.save_images(interpolated_images, output_path, nrow=steps)
print(f"Saved interpolation to {output_path}")

# SECTION 4: Generating Variations of an Image
# =========================================

print("\n=== Generating Variations of an Image ===\n")

# Check if we have a real bike image to use
sample_image_path = '../data/sample_bike.jpg'  # Update this path if needed

if os.path.exists(sample_image_path):
    # Load and preprocess the image
    img = load_and_preprocess_image(sample_image_path, IMG_SIZE)
    img = img.to(device)
    
    # Generate variations
    num_variations = 8
    print(f"Generating {num_variations} variations of the sample image...")
    
    # Display the original image
    with torch.no_grad():
        # Encode the image to get its latent representation
        mu, log_var = model.encoder(img.unsqueeze(0))
        
        # Decode back to get the reconstruction
        z = model.reparameterize(mu, log_var)
        recon = model.decoder(z)
        
        # Denormalize
        mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1).to(device)
        std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1).to(device)
        
        img_display = img.unsqueeze(0) * std + mean
        img_display = torch.clamp(img_display, 0, 1)
        
        recon = recon * std + mean
        recon = torch.clamp(recon, 0, 1)
        
        # Display original and reconstruction
        comparison = torch.cat([img_display, recon])
        grid = make_grid(comparison, nrow=2)
        
        plt.figure(figsize=(8, 4))
        plt.imshow(grid.permute(1, 2, 0).cpu())
        plt.axis('off')
        plt.title('Original Image (left) vs. Reconstruction (right)')
        plt.show()
    
    # Generate variations by adding noise to the latent vector
    variations = []
    std_dev = 0.5  # Standard deviation of the noise
    
    with torch.no_grad():
        for i in range(num_variations):
            # Add random noise to the latent vector
            noise = torch.randn_like(z) * std_dev
            z_var = z + noise
            
            # Decode to get variation
            var_img = model.decoder(z_var)
            
            # Denormalize
            var_img = var_img * std + mean
            var_img = torch.clamp(var_img, 0, 1)
            
            variations.append(var_img)
    
    # Concatenate all variations
    variations = torch.cat(variations, dim=0)
    
    # Display variations
    grid = make_grid(variations, nrow=4)
    plt.figure(figsize=(12, 6))
    plt.imshow(grid.permute(1, 2, 0).cpu())
    plt.axis('off')
    plt.title('Variations of the Input Image')
    plt.show()
    
    # Save variations
    output_path = '../generated_images/variations.png'
    generator.save_images(variations, output_path, nrow=4)
    print(f"Saved variations to {output_path}")
else:
    print("Sample image not found. Skipping variation generation.")
    print("You can add a sample bike image to the data directory and rerun this section.")

# SECTION 5: Exploring the Latent Space
# ==================================

print("\n=== Exploring the Latent Space ===\n")

# Generate a grid of images by varying two dimensions of the latent space
print("Generating latent space grid...")

# Create a grid of latent vectors by varying two dimensions
dim1_range = (-3.0, 3.0)
dim2_range = (-3.0, 3.0)
grid_size = 8
latent_dims = (0, 1)  # The two dimensions to vary

# Generate the grid
generator.generate_image_grid(
    dim1_range=dim1_range,
    dim2_range=dim2_range,
    grid_size=grid_size,
    latent_dims=latent_dims,
    filename='../generated_images/latent_grid.png'
)

print(f"Saved latent space grid to ../generated_images/latent_grid.png")

# Optionally, explore the latent space with t-SNE visualization
try:
    from sklearn.manifold import TSNE
    
    print("Exploring latent space with t-SNE...")
    generator.explore_latent_space(
        num_samples=100,
        perplexity=30,
        filename='../generated_images/latent_space.png',
        seed=42
    )
    
    print(f"Saved t-SNE visualization to ../generated_images/latent_space.png")
except ImportError:
    print("scikit-learn not found. Skipping t-SNE visualization.")

# SECTION 6: Creating an Animation
# =============================

print("\n=== Creating an Animation ===\n")

# Create animation frames by interpolating between two random points in latent space
print("Generating animation frames...")

# Generate two random latent vectors
z_start = generator.sample_latent_vectors(1, seed=42)
z_end = generator.sample_latent_vectors(1, seed=100)

# Generate animation frames
num_frames = 30
generator.generate_animation_frames(
    start_vector=z_start,
    end_vector=z_end,
    num_frames=num_frames,
    output_dir='../generated_images/animation'
)

print(f"Generated {num_frames} animation frames in ../generated_images/animation/")
print("You can use these frames to create a GIF or video.")

# Optional: Create a GIF from the frames
try:
    from PIL import Image
    import glob
    
    # Get all frames
    frames = []
    frame_files = sorted(glob.glob('../generated_images/animation/frame_*.png'))
    
    for frame_file in frame_files:
        frame = Image.open(frame_file)
        frames.append(frame)
    
    # Save as GIF
    frames[0].save(
        '../generated_images/animation.gif',
        save_all=True,
        append_images=frames[1:],
        optimize=True,
        duration=100,
        loop=0
    )
    
    print("Created animation GIF at ../generated_images/animation.gif")
except Exception as e:
    print(f"Error creating GIF: {e}")
    print("You can manually create a GIF from the generated frames.")

print("\nImage generation notebook complete!")
print("Check the '../generated_images/' directory for all generated images.")
