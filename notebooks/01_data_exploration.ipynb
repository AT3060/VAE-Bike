"""
Bike VAE Project - Jupyter Notebook for Data Exploration

This notebook demonstrates how to explore and visualize the bike image dataset
before training the Variational Autoencoder.
"""

import os
import sys
import torch
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from torchvision import transforms
from torch.utils.data import DataLoader

# Add project root to path
sys.path.append('..')

# Import project modules
from src.data_loading import BikeDataset, get_data_loaders, visualize_augmentations

# Set random seed for reproducibility
torch.manual_seed(42)
np.random.seed(42)

# Configuration
DATA_DIR = "../data"  # Update this to your dataset path
IMG_SIZE = (128, 128)
BATCH_SIZE = 32

# Check if CUDA is available
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# Create dataset and dataloader
print("Creating dataset and dataloader...")
train_dataset = BikeDataset(DATA_DIR, img_size=IMG_SIZE, split='train')
val_dataset = BikeDataset(DATA_DIR, img_size=IMG_SIZE, split='val')

print(f"Train dataset size: {len(train_dataset)}")
print(f"Validation dataset size: {len(val_dataset)}")

# Create dataloaders
train_loader, val_loader = get_data_loaders(
    DATA_DIR, 
    batch_size=BATCH_SIZE, 
    img_size=IMG_SIZE
)

# Visualize some sample images from the dataset
def show_batch(dataloader, num_samples=8):
    """Display a batch of images from the dataloader."""
    # Get a batch of images
    images = next(iter(dataloader))[:num_samples]
    
    # Denormalize images (assuming normalization with ImageNet stats)
    mean = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)
    std = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)
    
    images = images * std + mean
    images = torch.clamp(images, 0, 1)
    
    # Create a grid of images
    grid = torchvision.utils.make_grid(images, nrow=4)
    
    # Display the grid
    plt.figure(figsize=(12, 6))
    plt.imshow(grid.permute(1, 2, 0))
    plt.axis('off')
    plt.title('Sample Images from Dataset')
    plt.show()

# Show a batch of training images
print("Displaying sample images from the training set:")
show_batch(train_loader)

# Visualize data augmentations
print("Visualizing data augmentations:")
visualize_augmentations(DATA_DIR, img_size=IMG_SIZE, num_samples=3)

# Analyze image statistics
def analyze_image_statistics(dataloader):
    """Analyze the statistics of images in the dataloader."""
    # Initialize variables for mean and std calculation
    mean = torch.zeros(3)
    std = torch.zeros(3)
    
    # Iterate over batches
    print("Calculating image statistics...")
    for batch in dataloader:
        # Denormalize images
        batch_mean = torch.mean(batch, dim=[0, 2, 3])
        batch_std = torch.std(batch, dim=[0, 2, 3])
        
        mean += batch_mean
        std += batch_std
    
    # Calculate average
    mean /= len(dataloader)
    std /= len(dataloader)
    
    print(f"Mean: {mean}")
    print(f"Std: {std}")
    
    return mean, std

# Analyze image statistics
mean, std = analyze_image_statistics(train_loader)

# Check for class imbalance (if applicable)
print("Dataset summary:")
print(f"Total number of images: {len(train_dataset) + len(val_dataset)}")
print(f"Training set size: {len(train_dataset)} ({len(train_dataset) / (len(train_dataset) + len(val_dataset)):.2%})")
print(f"Validation set size: {len(val_dataset)} ({len(val_dataset) / (len(train_dataset) + len(val_dataset)):.2%})")

# Conclusion
print("\nData exploration complete!")
print("The dataset is ready for training the VAE model.")
